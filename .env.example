# Nansen API key: https://app.nansen.ai -> API.
# Copy this file to .env (it is gitignored), or just pass the variable inline:
#     NANSEN_API_KEY=... python3 cli.py flows 24h
NANSEN_API_KEY=

# Where the contribution tally is written (sqlite). Defaults to a file next to the code.
# NANSEN_DB_PATH=/tmp/nansen_local.db

# Anti-gaming: repeating THE SAME request by the same person more often than once every N
# minutes does not count towards the tally. It is not blocked - it is simply not counted.
# NANSEN_REPEAT_MIN=10
