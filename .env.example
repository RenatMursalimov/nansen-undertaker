# Ключ Nansen API: https://app.nansen.ai -> API.
# Скопируй этот файл в .env (он в .gitignore) либо просто передай переменную в команде:
#     NANSEN_API_KEY=... python3 cli.py flows 24h
NANSEN_API_KEY=

# Куда писать зачёт вклада (sqlite). По умолчанию файл рядом с кодом.
# NANSEN_DB_PATH=/tmp/nansen_local.db

# Антинакрутка: повтор ТОГО ЖЕ запроса того же человека чаще, чем раз в N минут, в зачёт
# вклада не идёт. Не блокирует - именно не засчитывает.
# NANSEN_REPEAT_MIN=10
