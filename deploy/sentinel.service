[Unit]
# ОТДЕЛЬНЫЙ ЮНИТ ДОЗОРНОГО. Решение владельца 25.09: «включай Отдельный юнит sentinel.main».
#
# ЗАЧЕМ ОН НУЖЕН - ТРИ ИЗМЕРЕННЫЕ ПРИЧИНЫ, НИ ОДНА НЕ ПРО ЭСТЕТИКУ:
#  1. ДЕПЛОЙ. Обновление бота = рестарт службы, а горячее кольцо живёт в памяти процесса: после
#     каждого `git pull` дозорный терял 90 минут истории и молчал, пока не наберёт заново. У
#     владельца это уже выглядело как «включил, ничего не пришло».
#  2. ОБЩИЙ ЦИКЛ. В боте живут Telethon, PTB и несколько десятков джоб; пропуски там случались
#     (сторож `jobs_registry` для этого и заведён). Опрос раз в 30 секунд такому соседству не идёт.
#  3. ОТВЕТСТВЕННОСТЬ. Упавший дозорный не должен ронять бота, а упавший бот не должен прекращать
#     наблюдение за рынком.
#
# ДОМЕН НЕ ДУБЛИРУЕТСЯ: этот процесс зовёт ТЕ ЖЕ функции `engine.*`, что и джобы бота. Аренда
# (`store.lease`) не даёт двум опрашивать площадку одновременно - поэтому переключение безопасно
# даже в тот момент, когда живы оба.
Description=Undertaker Sentinel (Variational + Hyperliquid + smart ignition)
Documentation=https://github.com/RenatMursalimov/nansen-undertaker/blob/main/docs/SENTINEL_SPEC.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=<BOT_DIR>
EnvironmentFile=<BOT_DIR>/.env
# РОЛЬ - ГЛАВНАЯ СТРОКА ЭТОГО ЮНИТА. Её читает `engine._ingest`, и она отвечает на вопрос «моя
# ли это работа», а не «где вообще идёт опрос».
# ЗАМЕР 26.09, ПОЧЕМУ ОДНОГО ФЛАГА НЕ ХВАТИЛО: юнит ставил себе `SENTINEL_IN_BOT=0` (правда:
# «опрос не в боте»), а тик читал это как «опрашивает кто-то другой» и выходил. В логе юнита за
# сутки не было ни одной строки «опрошено», в логе бота - 134 подхвата, кольцо дырявое, сигма не
# набиралась. Роль эту двусмысленность снимает: `poller` опрашивает всегда.
Environment=SENTINEL_ROLE=poller
# ФЛАГ ОСТАВЛЕН РАДИ СОВМЕСТИМОСТИ: его читает только бот (роль `deliver`), чтобы не опрашивать
# рядом с живым юнитом. Обратный путь по-прежнему одна строка: убрать юнит, вернуть 1 в `.env`.
Environment=SENTINEL_IN_BOT=0
ExecStart=<BOT_DIR>/venv/bin/python3 -u -m sentinel.main
# -u (unbuffered) ОБЯЗАТЕЛЕН: без него строки дозорного оседают в буфере, и `journalctl` показывает
# пустоту там, где процесс работает. Тот же приём, что в ручном прогоне bot.py.
Restart=always
RestartSec=5
StandardOutput=append:<BOT_DIR>/sentinel.log
StandardError=append:<BOT_DIR>/sentinel.log
# СВОЙ ЛОГ, А НЕ ОБЩИЙ bot.log: главный лог бота разбирают grep-ом, и подмешивать туда вторую
# службу значит ломать главный инструмент диагностики (закон №1 проекта). Смотреть:
#   tail -f <BOT_DIR>/sentinel.log
#   grep -a 'опрошено' <BOT_DIR>/sentinel.log | tail -5

[Install]
WantedBy=multi-user.target
